generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model FileMetadata {
  id         Int      @id @default(autoincrement())
  key        String   @unique
  size       Int?
  mimeType   String
  hash       String?
  status     String   @default("UPLOADED")
  uploadedAt DateTime @default(now())
  uploaderId Int?
}
